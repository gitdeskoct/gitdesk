{
  "name": "gitdesk",
  "productName": "gitdesk",
  "version": "1.0.6",
  "private": true,
  "description": "A local-first desktop Git client with pull request reviews and a Cloudflare Worker backend.",
  "keywords": [
    "git",
    "git-client",
    "electron",
    "desktop",
    "pull-requests",
    "cloudflare",
    "typescript"
  ],
  "license": "MIT",
  "author": {
    "name": "TELVIN TEUM",
    "email": "telvinteum@ubunifucollege.com"
  },
  "main": ".vite/build/main.cjs",
  "scripts": {
    "start": "electron-forge start",
    "build": "electron-forge package",
    "dist": "npm run build && electron-builder --publish never",
    "dist:dir": "npm run build && electron-builder --dir --publish never",
    "lint": "oxlint && oxfmt --check",
    "lint:fix": "oxlint --fix && oxfmt --write",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
