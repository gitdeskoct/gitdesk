{
  "name": "gitdesk-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local --var GIT_HOSTING:off",
    "dev:remote": "wrangler dev --var GIT_HOSTING:artifacts",
    "dev:hosted": "node scripts/dev-hosted.mjs",
    "git-host:local": "node scripts/local-git-host.mjs .wrangler/local-git-host",
    "deploy": "wrangler deploy --minify --env=",
    "deploy:dev": "wrangler deploy --minify --env dev",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings --strict-vars=false",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote --env=",
    "db:migrate:dev": "wrangler d1 migrations apply DB --remote --env dev",
    "tail": "wrangler tail --env= --format pretty",
    "tail:dev": "wrangler tail --env dev --format pretty"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.1",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "jose": "^6.2.13",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@cloudflare/vitest-plugin": "1.4.0",
    "@cloudflare/workers-types": "^5.20261019.1",
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "~5.0.5",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "~4.1.12",
    "wrangler": "^4.152.0"
  }
}
