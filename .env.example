#   dev         https://gitdesk-api-dev.telvinteum.workers.dev
#   local       http://localhost:8787 (unpackaged builds only, with `npm run dev` in backend/)
VITE_API_ORIGIN=https://gitdesk-api.telvinteum.workers.dev
