# Origin of the gitdesk API Worker. Must be https in packaged builds, and is baked in at build time.
#   live        https://gitdesk-api-dev.telvinteum.workers.dev (what released builds use; the
#               gitdesk-api Worker for wrangler.jsonc's top-level environment isn't deployed)
#   local       http://localhost:8787 (unpackaged builds only, with `npm run dev` in backend/)
VITE_API_ORIGIN=https://gitdesk-api-dev.telvinteum.workers.dev
